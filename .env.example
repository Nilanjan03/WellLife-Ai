# WellLife AI Environment Variables

# Mistral AI API Key (required for floating AI assistant)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Mistral Model (default is mistral-small-latest)
# Options: mistral-small-latest, mistral-medium-latest, mistral-large-latest, open-mistral-7b
MISTRAL_MODEL=mistral-small-latest

# WorkoutX API Key (for live library with 2,760+ exercises & HD video loops)
WORKOUTX_API_KEY=wx_78fbd0580bddd8e01e5ef360e6173b4ec564861bf41ebc658ef13d04

# Server Port (default: 3000)
PORT=3000
